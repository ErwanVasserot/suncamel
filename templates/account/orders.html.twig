{% extends 'base.html.twig' %}

{% block title %}My orders | {{ site.name }}{% endblock %}

{% macro order_card(row) %}
    {% set booking = row.booking %}
    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_12px_35px_rgba(15,23,42,0.08)]">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-6 py-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Order</p>
                <h3 class="text-xl font-bold text-blue-950">{{ booking.reference }}</h3>
            </div>
            <span class="rounded-full px-3 py-1 text-sm font-semibold {{ booking.status == 'paid' ? 'bg-green-100 text-green-800' : (booking.status == 'pending' ? 'bg-amber-100 text-amber-800' : 'bg-slate-200 text-slate-700') }}">
                {{ booking.status|capitalize }}
            </span>
        </div>

        <div class="grid gap-5 p-6 md:grid-cols-[1fr_auto]">
            <div class="grid gap-4">
                {% for item in booking.items %}
                    <div class="grid gap-1 border-b border-slate-100 pb-4 last:border-0 last:pb-0">
                        <strong>{{ item.product.title }}</strong>
                        <span class="text-sm text-slate-600">{{ item.pickupAt|date('d M Y, H:i', 'Pacific/Auckland') }} – {{ item.returnAt|date('d M Y, H:i', 'Pacific/Auckland') }}</span>
                        <span class="text-sm text-slate-600">{{ item.periodLabel }} · Quantity: {{ item.quantity }}</span>
                    </div>
                {% endfor %}
            </div>
            <div class="min-w-32 md:text-right">
                <p class="text-sm text-slate-500">Total</p>
                <strong class="text-xl">{{ booking.currency }} {{ (booking.totalAmount / 100)|number_format(2, '.', ',') }}</strong>
                <p class="mt-2 text-xs text-slate-500">Ordered {{ booking.createdAt|date('d M Y', 'Pacific/Auckland') }}</p>
            </div>
        </div>
    </article>
{% endmacro %}

{% block body %}
    {% import _self as orders %}
    {% include 'partials/header.html.twig' %}

    <main class="page-gradient py-16">
        <section class="container">
            <div class="max-w-2xl">
                <p class="text-sm font-semibold uppercase tracking-wide text-blue-800">My account</p>
                <h1 class="mt-2 text-4xl font-bold">My orders</h1>
                <p class="mt-3 text-slate-600">Review your upcoming rentals and your order history.</p>
            </div>

            <section class="mt-10">
                <h2 class="text-2xl font-bold">Upcoming orders</h2>
                <div class="mt-5 grid gap-5">
                    {% for row in upcoming_orders %}
                        {{ orders.order_card(row) }}
                    {% else %}
                        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">You have no upcoming orders.</div>
                    {% endfor %}
                </div>
            </section>

            <section class="mt-12">
                <h2 class="text-2xl font-bold">Past orders</h2>
                <div class="mt-5 grid gap-5">
                    {% for row in past_orders %}
                        {{ orders.order_card(row) }}
                    {% else %}
                        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">You have no past orders.</div>
                    {% endfor %}
                </div>
            </section>
        </section>
    </main>

    {% include 'partials/footer.html.twig' %}
{% endblock %}
