{% extends 'base.html.twig' %}

{% block title %}Your cart | {{ site.name }}{% endblock %}

{% block body %}
    {% include 'partials/header.html.twig' %}
    <main class="page-gradient py-12">
        <section class="container">
            <h1 class="text-4xl font-semibold">Your rental cart</h1>

            {% for message in app.flashes('error') %}
                <div class="mt-6 rounded-xl bg-red-50 p-4 font-semibold text-red-700">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="mt-6 rounded-xl bg-green-50 p-4 font-semibold text-green-700">{{ message }}</div>
            {% endfor %}

            {% if items is empty %}
                <div class="mt-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                    <p class="text-lg text-slate-600">Your cart is empty.</p>
                    <a class="btn btn-primary mt-6" href="/collections/all">Choose a bike</a>
                </div>
            {% else %}
                <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_340px]">
                    <div class="grid gap-4">
                        {% for item in items %}
                            <article class="grid gap-5 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:grid-cols-[160px_1fr_auto]">
                                <img class="h-36 w-full rounded-xl object-contain" src="{{ fallback_asset('/images/suncamel/products/' ~ item.product.coverImage) }}" alt="{{ item.product.title }}">
                                <div>
                                    <h2 class="text-xl font-semibold">{{ item.product.title }}</h2>
                                    <p class="mt-2 text-slate-600">{{ item.pickup|date('d M Y, H:i', 'Pacific/Auckland') }} → {{ item.return|date('d M Y, H:i', 'Pacific/Auckland') }}</p>
                                    <p class="mt-1 text-slate-600">{{ item.period_label }}</p>
                                    <div class="mt-3 flex items-center gap-3" aria-label="Quantity for {{ item.product.title }}">
                                        <form method="post" action="{{ path('cart_update', {key: item.key}) }}">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_update_' ~ item.key) }}">
                                            <input type="hidden" name="quantity" value="{{ item.quantity - 1 }}">
                                            <button class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 font-semibold disabled:cursor-not-allowed disabled:opacity-40" type="submit" aria-label="Decrease quantity"{{ item.quantity <= 1 ? ' disabled' : '' }}>−</button>
                                        </form>
                                        <span class="min-w-6 text-center font-semibold" aria-live="polite">{{ item.quantity }}</span>
                                        <form method="post" action="{{ path('cart_update', {key: item.key}) }}">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_update_' ~ item.key) }}">
                                            <input type="hidden" name="quantity" value="{{ item.quantity + 1 }}">
                                            <button class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 font-semibold disabled:cursor-not-allowed disabled:opacity-40" type="submit" aria-label="Increase quantity"{{ item.quantity >= available_quantities[item.key] ? ' disabled' : '' }}>+</button>
                                        </form>
                                        <span class="text-sm text-slate-500">{{ available_quantities[item.key] }} available</span>
                                    </div>
                                    <p class="mt-1 text-sm text-slate-500">NZ${{ (item.unit_amount / 100)|number_format(2, '.', ',') }}{% if item.days > 1 %} per day{% endif %}</p>
                                    {% if not availability[item.key] %}<p class="mt-2 font-semibold text-red-600">No longer available for this period.</p>{% endif %}
                                </div>
                                <div class="flex flex-col items-end justify-between gap-4">
                                    <strong class="text-lg">NZ${{ (item.total_amount / 100)|number_format(2, '.', ',') }}</strong>
                                    <form method="post" action="{{ path('cart_remove', {key: item.key}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_remove_' ~ item.key) }}">
                                        <button class="text-sm font-semibold text-red-600 underline" type="submit">Remove</button>
                                    </form>
                                </div>
                            </article>
                        {% endfor %}
                        <div>
                            <a class="btn border border-blue-800 bg-white text-blue-800 hover:bg-blue-50" href="{{ path('page_show', {slug: 'collections/all'}) }}">
                                Continue booking with another bike
                            </a>
                        </div>
                    </div>
                    <aside class="h-fit rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                        <form class="mb-6 grid gap-3 border-b border-slate-200 pb-6" method="post" action="{{ path('cart_promotion_apply') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_promotion') }}">
                            <label class="grid gap-2 text-sm font-semibold text-slate-700">
                                Promotion code
                                <div class="flex gap-2">
                                    <input class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 uppercase" type="text" name="code" value="{{ promotion ? promotion.code : '' }}" autocomplete="off" required>
                                    <button class="btn border border-blue-800 bg-white px-4 text-blue-800 hover:bg-blue-50" type="submit">Apply</button>
                                </div>
                            </label>
                        </form>
                        {% if promotion %}
                            <div class="mb-5 rounded-xl bg-green-50 p-4 text-sm text-green-800">
                                <div class="flex items-center justify-between gap-3">
                                    <strong>{{ promotion.code }} · {{ promotion.discountPercent }}% off</strong>
                                    <form method="post" action="{{ path('cart_promotion_remove') }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_promotion_remove') }}">
                                        <button class="font-semibold underline" type="submit">Remove</button>
                                    </form>
                                </div>
                            </div>
                            <div class="flex justify-between text-sm text-slate-600"><span>Subtotal</span><span>NZ${{ (subtotal_amount / 100)|number_format(2, '.', ',') }}</span></div>
                            <div class="mt-2 flex justify-between text-sm font-semibold text-green-700"><span>Discount</span><span>−NZ${{ (discount_amount / 100)|number_format(2, '.', ',') }}</span></div>
                        {% endif %}
                        <div class="{{ promotion ? 'mt-4 border-t border-slate-200 pt-4 ' : '' }}flex justify-between text-xl font-semibold"><span>Total</span><span>NZ${{ (total_amount / 100)|number_format(2, '.', ',') }}</span></div>
                        <p class="mt-2 text-sm text-slate-500">The total is calculated from the number of rental days.</p>
                        <form class="mt-6 grid gap-3" method="post" action="{{ path('checkout_create') }}" data-turbo="false">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('checkout') }}">
                            <label class="grid gap-2 text-sm font-semibold text-slate-700">
                                Email address
                                <input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="email" name="email" value="{{ app.user ? app.user.email : '' }}" autocomplete="email" required>
                            </label>
                            <p class="text-sm text-slate-500">We will send your booking confirmation to this address. No account is required.</p>
                            {% if not app.user %}
                                <label class="flex items-center gap-3 text-sm font-semibold text-slate-700">
                                    <input class="h-4 w-4 rounded border-slate-300" type="checkbox" name="want_account" value="1">
                                    I want an account
                                </label>
                            {% endif %}
                            <button class="btn btn-primary w-full" type="submit"{{ false in availability ? ' disabled' : '' }}>Proceed to payment</button>
                        </form>
                    </aside>
                </div>
            {% endif %}
        </section>
    </main>
    {% include 'partials/footer.html.twig' %}
{% endblock %}
