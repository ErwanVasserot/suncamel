{% set data = block.data ?? {} %}
<section class="relative min-h-[360px] flex items-center text-white">
    {% if data.image is defined %}
        <div class="absolute inset-0">
            <img class="h-full w-full object-cover" src="{{ data.image }}" alt="">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-900/70 to-blue-900/20"></div>
        </div>
    {% endif %}
    <div class="container relative">
        {% if data.title is defined %}
            <p class="text-xs uppercase tracking-[0.2em]">{{ data.eyebrow ?? 'Page' }}</p>
            <h1 class="mt-3 text-5xl font-semibold">{{ data.title }}</h1>
        {% endif %}
        {% if data.subtitle is defined %}
            <p class="mt-3 text-base text-white/80 leading-relaxed">{{ data.subtitle }}</p>
        {% endif %}
    </div>
</section>
