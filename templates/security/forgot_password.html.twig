{% extends 'base.html.twig' %}

{% block title %}Forgot password | {{ site.name }}{% endblock %}

{% block body %}
    {% include 'partials/header.html.twig' %}
    <main class="page-gradient py-16">
        <section class="container max-w-[520px]">
            <div class="rounded-2xl bg-white p-8 shadow-[0_18px_50px_rgba(10,18,38,0.12)] ring-1 ring-slate-200">
                <h1 class="text-3xl font-semibold">Forgot your password?</h1>
                <p class="mt-3 text-slate-600">Enter your email address and we will send you a reset link valid for one hour.</p>
                {% for message in app.flashes('success') %}<p class="mt-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">{{ message }}</p>{% endfor %}
                {% if error %}<p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{{ error }}</p>{% endif %}
                <form class="mt-6 grid gap-4" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                    <label class="grid gap-2 text-sm font-semibold text-slate-700">Email<input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="email" name="email" autocomplete="email" required autofocus></label>
                    <button class="btn btn-primary mt-2 w-fit text-[14px]" type="submit">Send reset link</button>
                </form>
                <p class="mt-5 text-sm"><a class="font-semibold text-blue-800 underline" href="{{ path('app_login') }}">Back to login</a></p>
            </div>
        </section>
    </main>
    {% include 'partials/footer.html.twig' %}
{% endblock %}
