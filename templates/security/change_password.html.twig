{% extends 'base.html.twig' %}

{% block title %}Change password | {{ site.name }}{% endblock %}

{% block body %}
    {% include 'partials/header.html.twig' %}
    <main class="page-gradient py-16">
        <section class="container max-w-[520px]">
            <div class="rounded-2xl bg-white p-8 shadow-[0_18px_50px_rgba(10,18,38,0.12)] ring-1 ring-slate-200">
                <h1 class="text-3xl font-semibold">Change password</h1>
                {% for message in app.flashes('success') %}<p class="mt-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">{{ message }}</p>{% endfor %}
                {% for error in errors %}<p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{{ error }}</p>{% endfor %}
                <form class="mt-6 grid gap-4" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('change_password') }}">
                    <label class="grid gap-2 text-sm font-semibold text-slate-700">Current password<input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="password" name="current_password" autocomplete="current-password" required></label>
                    <label class="grid gap-2 text-sm font-semibold text-slate-700">New password<input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="password" name="password" autocomplete="new-password" minlength="8" required></label>
                    <label class="grid gap-2 text-sm font-semibold text-slate-700">Confirm new password<input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="password" name="confirm_password" autocomplete="new-password" minlength="8" required></label>
                    <button class="btn btn-primary mt-2 w-fit text-[14px]" type="submit">Change password</button>
                </form>
            </div>
        </section>
    </main>
    {% include 'partials/footer.html.twig' %}
{% endblock %}
