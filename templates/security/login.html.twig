{% extends 'base.html.twig' %}

{% block title %}Login | {{ site.name }}{% endblock %}

{% block body %}
    {% include 'partials/header.html.twig' %}

    <main class="page-gradient py-16">
        <section class="container max-w-[520px]">
            <div class="rounded-2xl bg-white p-8 shadow-[0_18px_50px_rgba(10,18,38,0.12)] ring-1 ring-slate-200">
                <h1 class="text-3xl font-semibold">Login</h1>

                {% for message in app.flashes('success') %}
                    <p class="mt-4 rounded-lg bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">
                        {{ message }}
                    </p>
                {% endfor %}

                {% if error %}
                    <p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
                        Invalid email or password.
                    </p>
                {% endif %}

                <form class="mt-6 grid gap-4" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <label class="grid gap-2 text-sm font-semibold text-slate-700">
                        Email
                        <input
                            class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal"
                            type="email"
                            name="_username"
                            value="{{ last_username }}"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </label>

                    <label class="grid gap-2 text-sm font-semibold text-slate-700">
                        Password
                        <input
                            class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal"
                            type="password"
                            name="_password"
                            autocomplete="current-password"
                            required
                        >
                    </label>

                    <button class="btn btn-primary mt-2 w-fit text-[14px]" type="submit">Login</button>
                </form>

                <p class="mt-5 text-sm">
                    <a class="font-semibold text-blue-800 underline" href="{{ path('forgot_password') }}">Forgot your password?</a>
                </p>

                <p class="mt-3 text-sm text-slate-600">
                    No account yet? <a class="font-semibold text-blue-800 underline" href="/register">Create an account</a>.
                </p>
            </div>
        </section>
    </main>

    {% include 'partials/footer.html.twig' %}
{% endblock %}
