{% extends 'base.html.twig' %}

{% block title %}Reset password | {{ site.name }}{% endblock %}

{% block body %}
    {% include 'partials/header.html.twig' %}
    <main class="page-gradient py-16">
        <section class="container max-w-[520px]">
            <div class="rounded-2xl bg-white p-8 shadow-[0_18px_50px_rgba(10,18,38,0.12)] ring-1 ring-slate-200">
                <h1 class="text-3xl font-semibold">Reset password</h1>
                {% if invalid %}
                    <p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">This reset link is invalid or has expired.</p>
                    <p class="mt-5 text-sm"><a class="font-semibold text-blue-800 underline" href="{{ path('forgot_password') }}">Request a new link</a></p>
                {% else %}
                    {% for error in errors %}<p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{{ error }}</p>{% endfor %}
                    <form class="mt-6 grid gap-4" method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password_' ~ token) }}">
                        <label class="grid gap-2 text-sm font-semibold text-slate-700">New password<input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="password" name="password" autocomplete="new-password" minlength="8" required autofocus></label>
                        <label class="grid gap-2 text-sm font-semibold text-slate-700">Confirm new password<input class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal" type="password" name="confirm_password" autocomplete="new-password" minlength="8" required></label>
                        <button class="btn btn-primary mt-2 w-fit text-[14px]" type="submit">Reset password</button>
                    </form>
                {% endif %}
            </div>
        </section>
    </main>
    {% include 'partials/footer.html.twig' %}
{% endblock %}
