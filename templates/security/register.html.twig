{% extends 'base.html.twig' %}

{% block title %}Create account | {{ site.name }}{% endblock %}

{% block body %}
    {% include 'partials/header.html.twig' %}

    <main class="page-gradient py-16">
        <section class="container max-w-[560px]">
            <div class="rounded-2xl bg-white p-8 shadow-[0_18px_50px_rgba(10,18,38,0.12)] ring-1 ring-slate-200">
                <h1 class="text-3xl font-semibold">Create account</h1>

                {% if errors is not empty %}
                    <div class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
                        {% for error in errors %}
                            <p>{{ error }}</p>
                        {% endfor %}
                    </div>
                {% endif %}

                <form class="mt-6 grid gap-4" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

                    <label class="grid gap-2 text-sm font-semibold text-slate-700">
                        Email
                        <input
                            class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal"
                            type="email"
                            name="email"
                            value="{{ email }}"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </label>

                    <label class="grid gap-2 text-sm font-semibold text-slate-700">
                        Password
                        <input
                            class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal"
                            type="password"
                            name="password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                        >
                    </label>

                    <label class="grid gap-2 text-sm font-semibold text-slate-700">
                        Confirm password
                        <input
                            class="rounded-lg border border-slate-300 px-4 py-3 text-base font-normal"
                            type="password"
                            name="confirm_password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                        >
                    </label>

                    <button class="btn btn-primary mt-2 w-fit text-[14px]" type="submit">Create account</button>
                </form>

                <p class="mt-5 text-sm text-slate-600">
                    Already have an account? <a class="font-semibold text-blue-800 underline" href="/login">Login</a>.
                </p>
            </div>
        </section>
    </main>

    {% include 'partials/footer.html.twig' %}
{% endblock %}
